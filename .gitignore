# Drawio: arquivos de trava/backup temporários do editor
**/.$*.drawio.bkp

# dual-graph MCP: caches e estado de runtime locais (regenerados a cada sessão)
.dual-graph/*.log
.dual-graph/*.pid
.dual-graph/mcp_port
.dual-graph/info_graph.json
.dual-graph/symbol_index.json
.dual-graph/retrieval_cache.json
.dual-graph/chat_action_graph.json
.dual-graph/mcp_tool_calls.jsonl

# dependências / build
node_modules/
dist/
.dual-graph/

# OMO: estado de continuação de sessão local (regenerado a cada sessão)
.omo/

# variáveis de ambiente (segredos do BFF — ver .env.example)
.env
.env.*
!.env.example

# Collection Bruno do ERP: vem com as credenciais preenchidas para funcionar
# logo no import, então `collection.bru` (bloco PADRAO do script), os
# environments e o arquivo único de export carregam client_secret e senha em
# texto plano. Fica tudo de fora do versionamento.
#
# O que é versionado é `CentriumERP.openapi.json`, derivado do contrato do ERP
# e sem segredo nenhum — dele a collection é regerada quando preciso.
docs/bruno/CentriumERP/
docs/bruno/*.bruno-collection.json

# saídas de teste
coverage/
playwright-report/
test-results/
.vite/

# logs e artefatos de editor
*.log
.DS_Store
Thumbs.db
