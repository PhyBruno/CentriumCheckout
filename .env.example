# Variáveis de ambiente do BFF (ver src/server/config/env.ts).
# Valores abaixo são SINTÉTICOS — copie para `.env` e ajuste por ambiente.
# Nenhum destes valores deve ser commitado com conteúdo real.

# Domínio base do ERP. O host efetivo é montado como `<tenant>.<baseDomain>` (AD-019).
baseDomain=apps.example.test

# Credencial fixa por ambiente que valida a origem do redirect do ERP em GET /session/start.
# Não é uma credencial OAuth do operador (AD-022).
validationKey=dev-validation-key

# Chave de servidor usada para cifrar o cookie de sessão (AES-256-GCM).
# Mínimo de 32 caracteres. Gere um valor aleatório por ambiente.
SESSION_SECRET=dev-only-secret-change-me-0123456789

# Porta do processo Node (BFF + assets estáticos da SPA).
PORT=3000

# Protocolo usado para falar com o ERP. Use `http` apenas em dev com ERP mockado.
ERP_PROTOCOL=https

# APENAS DEV/TESTE: força um host fixo para o ERP, ignorando `<tenant>.<baseDomain>`.
# Existe porque subdomínios de `localhost` não resolvem em todos os SOs, o que
# impediria os cenários do quickstart contra um ERP mockado local.
# MUST ficar vazio em produção.
# ERP_HOST_OVERRIDE=127.0.0.1:4010
